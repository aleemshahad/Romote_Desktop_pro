{
  "name": "romte-remote",
  "version": "2.1.4",
  "description": "Remote desktop control + real-time PC/mobile chat over your LAN - open source, with Windows EXE builds",
  "main": "desktop/main.js",
  "bin": {
    "romte-remote": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "public",
    "server.js",
    "run_server.bat"
  ],
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.js",
    "icon": "node scripts/make-icon.js",
    "build:win": "npm run icon && electron-builder --win"
  },
  "keywords": [
    "remote-desktop",
    "remote-control",
    "chat",
    "lan",
    "socket.io",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleemshahad/Romote_Desktop_pro.git"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3"
  },
  "optionalDependencies": {
    "robotjs": "^0.9.1",
    "screenshot-desktop": "^1.15.6"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.romte.remote",
    "productName": "Romte Remote",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "desktop/**/*",
      "package.json",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Remote-Desktop-pro-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Romte Remote"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "Remote-Desktop-pro-Portable.exe"
    }
  }
}
